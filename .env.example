# Obtain a key from The Odds API. Never commit a real value.
ODDS_API_KEY=replace-with-your-odds-api-key

# CollegeFootballData research ingestion. Never commit a real value.
CFBD_API_KEY=replace-with-your-cfbd-api-key

# PostgreSQL is required in production. Obtain this from your database provider.
DATABASE_URL=postgresql://placeholder-user:placeholder-password@placeholder-host:5432/placeholder-database

# Private API authentication. Generate a strong value outside source control.
APP_API_KEY=replace-with-a-long-random-api-key
APP_OWNER_ID=default
APP_OWNER_NAME=Default Owner

# New portfolios use this amount. This is paper-trading configuration.
STARTING_BANKROLL=200.00

# Phase 3 provider safety and market freshness policy (all configurable).
PROVIDER_TIMEOUT_SECONDS=12.0
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.25
PROVIDER_CACHE_TTL_SECONDS=15.0
PROVIDER_LOW_QUOTA_THRESHOLD=10
MARKET_FRESHNESS_SECONDS=120

# Phase 4 market-consensus pricing and qualification policy.
PRICING_MINIMUM_BOOKS=2
PRICING_MINIMUM_EV=0.01
PRICING_MINIMUM_PROBABILITY_EDGE=0.005
PRICING_OUTLIER_THRESHOLD=0.03
PRICING_MAXIMUM_DISPERSION=0.08
PRICING_SUPPORTED_BOOKS=draftkings,fanduel,betmgm

# Phase 6 paper recommendation, fractional-Kelly, exposure, and parlay policy.
PORTFOLIO_MINIMUM_EV=0.015
PORTFOLIO_MINIMUM_EDGE=0.0075
PORTFOLIO_MAXIMUM_DISPERSION=0.06
PORTFOLIO_MINIMUM_BOOKS=2
PORTFOLIO_CORE_MINIMUM_EV=0.03
PORTFOLIO_CORE_MINIMUM_EDGE=0.015
PORTFOLIO_KELLY_FRACTION=0.25
PORTFOLIO_MINIMUM_STAKE=1.00
PORTFOLIO_MAXIMUM_STAKE=50.00
PORTFOLIO_MAXIMUM_CORE_BET_FRACTION=0.02
PORTFOLIO_MAXIMUM_OPPORTUNISTIC_BET_FRACTION=0.01
PORTFOLIO_MAXIMUM_DAILY_FRACTION=0.08
PORTFOLIO_MAXIMUM_GAME_FRACTION=0.04
PORTFOLIO_MAXIMUM_TEAM_FRACTION=0.05
PORTFOLIO_MAXIMUM_MARKET_FRACTION=0.05
PORTFOLIO_MAXIMUM_CORRELATED_FRACTION=0.04
PORTFOLIO_UNIT_FRACTION=0.04
PORTFOLIO_REDUCED_RISK_DRAWDOWN=0.10
PORTFOLIO_PAUSED_DRAWDOWN=0.20
PORTFOLIO_BANKROLL_FLOOR_FRACTION=0.50
PARLAY_ENABLED=true
PARLAY_MINIMUM_EV=0.05
PARLAY_KELLY_FRACTION=0.10
PARLAY_MAXIMUM_FRACTION=0.005
PARLAY_DAILY_FRACTION=0.01

# Retained for the explicit legacy JSON import utility; not primary runtime storage.
DATA_DIR=data

# Phase 5B offline NCAAF source ingestion. A separate research database URL is optional.
# NCAAF_RESEARCH_DATABASE_URL=postgresql://placeholder-user:placeholder-password@placeholder-host:5432/placeholder-research
NCAAF_ARTIFACT_DIR=.ncaaf-data
CFBD_TIMEOUT_SECONDS=30
