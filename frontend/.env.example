# Local Vite proxy only. These values stay server-side and are never exposed as VITE_* variables.
DASHBOARD_BACKEND_URL=http://127.0.0.1:8000
DASHBOARD_BACKEND_API_KEY=replace-with-local-app-api-key

# Safe client-visible configuration.
VITE_PORTFOLIO_ID=paper-main
VITE_DEMO_MODE=false

# Cloudflare Pages Function configuration is set in the Pages dashboard, not this file:
# BACKEND_API_URL=https://your-render-service.example
# BACKEND_API_KEY=store-as-an-encrypted-secret
